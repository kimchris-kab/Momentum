<?xml version="1.0" encoding="utf-8"?>
<!-- Sized for 4x4 (see momentum_widget_info.xml). Matches the app's dark palette: bg #16141F, text #F2EFFA, gold #E8B75D, calm teal #5FC7C0.
     Top to bottom: today's progress, the habits being broken (big clean-time counter + Urge),
     then every task for today in a list that scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8B75D"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="@string/widget_placeholder" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="#A29DB8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- The week at a glance: seven dots, oldest first, the last being today. Gold fills as more of the day's habits are done. Hidden until the
         app has sent them. -->
    <LinearLayout
        android:id="@+id/week_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:id="@+id/week_0" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_1" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_2" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_3" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_4" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_5" style="@style/MomentumWidgetDot" />
        <TextView android:id="@+id/week_6" style="@style/MomentumWidgetDot" />
    </LinearLayout>

    <!-- The break side. The time since the last slip is the biggest thing on the widget on
         purpose: it's the number that's worth protecting, and it should be the first thing the
         eye lands on. Each block carries an Urge button that opens straight into riding it out. -->
    <LinearLayout android:id="@+id/quit_0" style="@style/MomentumWidgetQuitRow">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">
                <TextView android:id="@+id/quit_0_time" style="@style/MomentumWidgetQuitTime" />
                <TextView android:id="@+id/quit_0_name" style="@style/MomentumWidgetQuitName" />
            </LinearLayout>
            <TextView android:id="@+id/quit_0_detail" style="@style/MomentumWidgetQuitDetail" />
            <TextView android:id="@+id/quit_0_risk" style="@style/MomentumWidgetQuitRisk" />
        </LinearLayout>
        <TextView android:id="@+id/quit_0_held" style="@style/MomentumWidgetHeld" />
        <TextView android:id="@+id/quit_0_urge" style="@style/MomentumWidgetUrge" />
    </LinearLayout>

    <LinearLayout android:id="@+id/quit_1" style="@style/MomentumWidgetQuitRow">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">
                <TextView android:id="@+id/quit_1_time" style="@style/MomentumWidgetQuitTime" />
                <TextView android:id="@+id/quit_1_name" style="@style/MomentumWidgetQuitName" />
            </LinearLayout>
            <TextView android:id="@+id/quit_1_detail" style="@style/MomentumWidgetQuitDetail" />
            <TextView android:id="@+id/quit_1_risk" style="@style/MomentumWidgetQuitRisk" />
        </LinearLayout>
        <TextView android:id="@+id/quit_1_held" style="@style/MomentumWidgetHeld" />
        <TextView android:id="@+id/quit_1_urge" style="@style/MomentumWidgetUrge" />
    </LinearLayout>

    <!-- A FrameLayout, not a View: widget layouts may only use classes RemoteViews allows, and
         a bare View is not one — it would take the whole widget down, not just the line. -->
    <FrameLayout
        android:id="@+id/quit_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="#2E2A3D"
        android:visibility="gone" />

    <!-- Your own notes to yourself, one at a time, fading from one to the next. A ViewFlipper (one of the
         few things a widget may use that moves on its own); the lines are added to it from the snapshot,
         and it stays gone when there are none. Slow on purpose: it is a glance, not an animation. -->
    <ViewFlipper
        android:id="@+id/pep_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:autoStart="true"
        android:flipInterval="9000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out"
        android:visibility="gone" />

    <!-- Today's virtue on a line, and, from the evening on, the question with its three answers. Both parts stay gone until the app
         sends something for them. -->
    <LinearLayout
        android:id="@+id/virtue_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/virtue_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C9C3DE"
            android:textSize="11.5sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <LinearLayout
            android:id="@+id/virtue_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/virtue_lived" style="@style/MomentumWidgetSmallButton" android:text="@string/widget_virtue_lived" />
            <TextView android:id="@+id/virtue_partly" style="@style/MomentumWidgetSmallButton" android:text="@string/widget_virtue_partly" />
            <TextView android:id="@+id/virtue_missed" style="@style/MomentumWidgetSmallButton" android:text="@string/widget_virtue_missed" />
        </LinearLayout>
    </LinearLayout>

    <!-- Every task for today. A ListView, not a fixed set of rows: it takes the room that's left
         and scrolls, so nothing is left off — the first version stopped at four. -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/widget_list_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#6B6683"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="@string/widget_empty" />

    <!-- What has been spent today, and up to three usual payments, one tap each. -->
    <LinearLayout
        android:id="@+id/spend_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/spend_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A29DB8"
            android:textSize="11sp"
            android:maxLines="1" />
        <TextView android:id="@+id/spend_chip_0" style="@style/MomentumWidgetChip" />
        <TextView android:id="@+id/spend_chip_1" style="@style/MomentumWidgetChip" />
        <TextView android:id="@+id/spend_chip_2" style="@style/MomentumWidgetChip" />
    </LinearLayout>
</LinearLayout>
