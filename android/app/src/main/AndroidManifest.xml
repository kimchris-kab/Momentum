<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- A widget provider is driven by broadcasts from the launcher, which is another
             app: exported="false" means those never arrive and the widget never appears in
             the picker at all. -->
        <receiver
            android:name=".MomentumWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/momentum_widget_info" />
        </receiver>

        <!-- Feeds the widget's task list. The system binds to it, not another app, so it isn't
             exported; the permission is what stops anything else asking it for the list. -->
        <service
            android:name=".MomentumWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- The habit counter in the notification shade. Driven by its own refresh alarm and by the
             system after a restart or an update, never by another app, so it isn't exported. -->
        <receiver
            android:name=".MomentumShade"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Notes to yourself: its own alarms, the reply box in its notification, and coming back after a
             restart. Reached by PendingIntents the system holds, never by another app, so not exported. -->
        <receiver
            android:name=".MomentumPep"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Logging money without the app: the box you type a payment into, its Save and Undo buttons, and coming back after a
             restart. Reached by PendingIntents the system holds, never by another app, so not exported. -->
        <receiver
            android:name=".MomentumMoney"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Texts from banks and mobile-money services. The system sends SMS_RECEIVED, so this has to be exported; the permission on it is what
             stops any other app pretending to be the system and handing it a made-up payment. -->
        <receiver
            android:name=".MoneySmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Payments announced by another app's notification. Bound by the system once the person grants notification access. -->
        <service
            android:name=".MoneyListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 and up won't show the habit counter without it. The local-notifications plugin
         declares both of these too; they're repeated so this app's own notification doesn't
         depend on a plugin's manifest staying as it is. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The breathing pacer's vibration. A normal permission: granted on install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading payment texts from the senders the person lists. Asked for only when they turn reading on, and it is a runtime permission:
         nothing is read until they say yes. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
</manifest>
