  "amountC": "(\\d{1,3}(?:,\\d{3})+(?:\\.\\d{1,2})?|\\d+(?:\\.\\d{1,2})?)\\s?({CUR})\\b",
  "dateSlash": "\\b(\\d{1,2})[/-](\\d{1,2})[/-](\\d{2}|\\d{4})\\b",
  "dateMonth": "\\b(\\d{1,2})[ -]?(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*[ ,-]*(\\d{2}|\\d{4})\\b",
  "time": "\\b(\\d{1,2}):(\\d{2})\\s?(am|pm)?\\b",
  "refLead": "^\\s*([A-Z0-9]{8,12})\\b\\s*(?:confirmed|Confirmed)",
