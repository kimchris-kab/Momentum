  "airtime": "\\bairtime\\b",
  "bought": "\\bbought\\b",
  "withdrawFrom": "\\bwithdraw(?:n)?\\b.*?\\bfrom\\s+\\d+\\s*[-–]\\s*([A-Za-z0-9 &'.]+?)(?=\\s+(?:new|on|at)\\b|\\.\\s|\\.$|$)",
  "withdraw": "\\bwithdraw(?:n)?\\b",
  "forAccount": "for account\\s+([A-Za-z0-9-]+)",
  "out": [
   "\\b(?:paid|sent|transferred|payment of)\\s+(?:(?:{CUR})\\s?[\\d,]+(?:\\.\\d+)?\\s+)?to\\s+(.+?){STOP}",
